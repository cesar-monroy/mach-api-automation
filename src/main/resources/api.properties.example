# API Configuration Example
# Copy this file as api.properties and configure according to your environment
# 
# ⚠️  IMPORTANT: 
# - Add api.properties to .gitignore to avoid committing credentials
# - NEVER commit real credentials to version control
# - For production, use environment variables or secrets management
# - This file is only for local development

# ============================================
# RECOMMENDED: Use Environment Variables
# ============================================
# For multiple services, use environment variables with service prefixes:
# 
# Account API:
#   ACCOUNT_API_BASE_URI=https://account-api.example.com
#   ACCOUNT_API_BEARER_TOKEN=your-token-here
#   ACCOUNT_API_API_KEY=your-api-key-here
#
# Payment API:
#   PAYMENT_API_BASE_URI=https://payment-api.example.com
#   PAYMENT_API_BEARER_TOKEN=your-token-here
#
# User API:
#   USER_API_BASE_URI=https://user-api.example.com
#   USER_API_BASE_PATH=/api/v2
#   USER_API_USERNAME=username
#   USER_API_PASSWORD=password

# ============================================
# Legacy: Single API Configuration (Optional)
# ============================================
# Only use this if you have a single API endpoint
# For multiple endpoints, use ServiceConfig.forService("serviceName")

# Base URI of the API
# api.base.uri=https://jsonplaceholder.typicode.com

# Base path (optional, default: /api/v1)
# api.base.path=

# Authentication - Bearer Token
# api.bearer.token=your-bearer-token-here

# Authentication - Basic Auth
# api.username=your-username
# api.password=your-password

# ============================================
# Multi-Service Configuration (Optional)
# ============================================
# You can also configure multiple services in properties file:
# (But environment variables are preferred for security)

# Account Service
# api.account.base.uri=https://account-api.example.com
# api.account.base.path=/api/v1
# api.account.bearer.token=account-token-here
# api.account.key=account-api-key-here

# Payment Service
# api.payment.base.uri=https://payment-api.example.com
# api.payment.base.path=/api/v1
# api.payment.bearer.token=payment-token-here

# User Service
# api.user.base.uri=https://user-api.example.com
# api.user.base.path=/api/v2
# api.user.username=user-api-username
# api.user.password=user-api-password

